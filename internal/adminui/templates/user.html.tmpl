{{define "title"}}{{.Data.Title}}{{end}}
{{define "content"}}
<section class="stack">
<p class="aside"><a href="{{.Base}}/users">{{.T "user.back"}}</a></p>
<h1 class="h1 break">{{.Data.Title}}</h1>
{{template "flash" .}}
<div class="card stack">
<h2 class="h2">{{.T "user.account"}}</h2>
<dl class="facts">
<dt>{{.T "user.id"}}</dt>
<dd><code class="break">{{.Data.ID}}</code></dd>
<dt>{{.T "user.status"}}</dt>
<dd><span class="badge badge-{{.Data.Status}}">{{.Data.StatusLabel}}</span></dd>
{{if eq .Data.Status "blocked"}}<dt>{{.T "user.blocked.reason"}}</dt>
<dd class="break">{{if .Data.BlockedReason}}{{.Data.BlockedReason}}{{else}}<span class="muted">{{.T "user.blocked.noreason"}}</span>{{end}}</dd>
<dt>{{.T "user.blocked.until"}}</dt>
<dd>{{if .Data.BlockedUntil.IsZero}}{{.T "user.blocked.forever"}}{{else}}{{.Time .Data.BlockedUntil}}{{end}}</dd>
{{end}}{{if not .Data.DeletedAt.IsZero}}<dt>{{.T "user.deleted.at"}}</dt>
<dd>{{.Time .Data.DeletedAt}}</dd>
{{end}}{{if not .Data.PurgeAfter.IsZero}}<dt>{{.T "user.deleted.until"}}</dt>
<dd>{{.Time .Data.PurgeAfter}}</dd>
{{end}}<dt>{{.T "user.created"}}</dt>
<dd>{{.Time .Data.CreatedAt}}</dd>
<dt>{{.T "users.via"}}</dt>
<dd>{{.Data.Via}}</dd>
<dt>{{.T "user.last"}}</dt>
<dd>{{if .Data.LastLoginAt.IsZero}}<span class="muted">{{.T "users.never.signed"}}</span>{{else}}{{.Time .Data.LastLoginAt}}{{end}}</dd>
<dt>{{.T "user.password"}}</dt>
<dd>{{if not .Data.HasPassword}}{{.T "user.password.none"}}{{else if .Data.MustChangePassword}}{{.T "user.must.change"}}{{else}}{{.T "user.password.set"}}{{end}}</dd>
</dl>
</div>
{{if ne .Data.Status "deleted"}}<div class="card stack">
<h2 class="h2">{{if eq .Data.Status "blocked"}}{{.T "user.block.change"}}{{else}}{{.T "user.block.title"}}{{end}}</h2>
<form method="post" action="{{.Base}}/users/{{.Data.ID}}/block" class="stack">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<div>
<label for="block-reason" class="label">{{.T "user.block.reason"}}</label>
<input id="block-reason" name="reason" type="text" class="input" required maxlength="{{.Data.ReasonLimit}}" value="{{.Data.BlockReason}}">
</div>
<div>
<label for="block-until" class="label">{{.T "user.block.until"}}</label>
<input id="block-until" name="until" type="date" class="input" value="{{.Data.BlockUntil}}" aria-describedby="block-until-hint">
<p id="block-until-hint" class="muted">{{.T "user.block.until.hint"}}</p>
</div>
<p class="muted">{{.T "user.block.hint"}}</p>
<div class="actions"><button type="submit" class="btn btn-danger">{{if eq .Data.Status "blocked"}}{{.T "user.block.change.submit"}}{{else}}{{.T "user.block.submit"}}{{end}}</button></div>
</form>
{{if eq .Data.Status "blocked"}}<form method="post" action="{{.Base}}/users/{{.Data.ID}}/unblock" class="stack">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<div class="actions"><button type="submit" class="btn btn-secondary">{{.T "user.unblock"}}</button></div>
</form>
{{end}}</div>
{{end}}{{if and .Data.Invited (ne .Data.Status "deleted")}}<div class="card stack">
<h2 class="h2">{{.T "user.invite.title"}}</h2>
<p class="muted">{{.T "user.invite.hint"}}</p>
{{if .Data.CanInvite}}<form method="post" action="{{.Base}}/users/{{.Data.ID}}/invitation" class="stack">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<div>
<label for="invite-language" class="label">{{.T "user.reset.language"}}</label>
<select id="invite-language" name="language" class="select">{{range .Data.MessageLanguages}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
</div>
<div class="actions"><button type="submit" class="btn btn-secondary">{{.T "user.invite.submit"}}</button></div>
</form>{{else}}<p class="muted">{{.T "newuser.invite.none"}}</p>{{end}}
</div>
{{end}}{{if ne .Data.Status "deleted"}}<div class="card stack">
<h2 class="h2">{{.T "user.reset.title"}}</h2>
{{if .Data.CanSend}}<form method="post" action="{{.Base}}/users/{{.Data.ID}}/password/link" class="stack">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<p class="muted">{{.T "user.reset.link.hint"}}</p>
<div>
<label for="link-language" class="label">{{.T "user.reset.language"}}</label>
<select id="link-language" name="language" class="select">{{range .Data.MessageLanguages}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
</div>
<div class="actions"><button type="submit" class="btn btn-secondary">{{.T "user.reset.link.submit"}}</button></div>
</form>{{else}}<p class="muted">{{.T "user.reset.nosender"}}</p>{{end}}
<form method="post" action="{{.Base}}/users/{{.Data.ID}}/password/temporary" class="stack">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<p class="muted">{{.T "user.reset.temp.hint"}}</p>
{{if .Data.CanSend}}<div>
<label for="temp-language" class="label">{{.T "user.reset.language"}}</label>
<select id="temp-language" name="language" class="select">{{range .Data.MessageLanguages}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select>
</div>
{{end}}<div class="actions"><button type="submit" class="btn btn-danger">{{.T "user.reset.temp.submit"}}</button></div>
</form>
</div>
{{end}}<div class="card stack">
<h2 class="h2">{{.T "user.identifiers"}}</h2>
{{if .Data.Identifiers}}<div class="scroll">
<table class="table">
<caption class="sr-only">{{.T "user.identifiers.caption"}}</caption>
<thead>
<tr>
<th scope="col">{{.T "user.ident.type"}}</th>
<th scope="col">{{.T "user.ident.value"}}</th>
<th scope="col">{{.T "user.ident.confirmed"}}</th>
<th scope="col"><span class="sr-only">{{.T "sessions.action"}}</span></th>
</tr>
</thead>
<tbody>
{{range .Data.Identifiers}}<tr>
<td>{{.Type}}</td>
<td class="break">{{.Value}}</td>
<td>{{if .Verified}}{{$.Time .VerifiedAt}}{{else}}<span class="muted">{{$.T "user.ident.no"}}</span>{{end}}</td>
<td>{{if .Editable}}<div class="stack">
<form method="post" action="{{$.Base}}/users/{{$.Data.ID}}/identifiers/set" class="actions">
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<input type="hidden" name="type" value="{{.Type}}">
<label for="value-{{.Type}}" class="sr-only">{{$.T "user.ident.new" .Type}}</label>
<input id="value-{{.Type}}" name="value" type="text" class="input" value="{{.Value}}" required maxlength="1024">
<button type="submit" class="btn btn-secondary btn-small">{{$.T "user.ident.save"}}</button>
</form>
{{if .CanConfirm}}<form method="post" action="{{$.Base}}/users/{{$.Data.ID}}/identifiers/verify">
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<input type="hidden" name="type" value="{{.Type}}">
<button type="submit" class="btn btn-secondary btn-small">{{$.T "user.ident.confirm"}}</button>
</form>
{{end}}{{if .CanRemove}}<form method="post" action="{{$.Base}}/users/{{$.Data.ID}}/identifiers/remove">
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<input type="hidden" name="type" value="{{.Type}}">
<button type="submit" class="btn btn-danger btn-small">{{$.T "user.ident.remove"}}</button>
</form>
{{end}}</div>{{end}}</td>
</tr>
{{end}}</tbody>
</table>
</div>{{else}}<p class="muted">{{.T "user.identifiers.none"}}</p>{{end}}
{{if .Data.MissingTypes}}<form method="post" action="{{.Base}}/users/{{.Data.ID}}/identifiers/set" class="stack">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<h3 class="label">{{.T "user.ident.add"}}</h3>
<div>
<label for="add-type" class="label">{{.T "user.ident.type"}}</label>
<select id="add-type" name="type" class="select">{{range .Data.MissingTypes}}<option value="{{.Value}}">{{.Label}}</option>{{end}}</select>
</div>
<div>
<label for="add-value" class="label">{{.T "user.ident.value"}}</label>
<input id="add-value" name="value" type="text" class="input" required maxlength="1024">
</div>
<div class="actions"><button type="submit" class="btn btn-primary">{{.T "user.ident.add.submit"}}</button></div>
</form>
{{end}}</div>
<div class="card stack">
<h2 class="h2">{{.T "user.sessions"}}</h2>
{{if .Data.Sessions}}<div class="scroll">
<table class="table">
<caption class="sr-only">{{.T "user.sessions.caption"}}</caption>
<thead>
<tr>
<th scope="col">{{.T "sessions.started"}}</th>
<th scope="col">{{.T "sessions.seen"}}</th>
<th scope="col">{{.T "user.sessions.ends"}}</th>
<th scope="col">{{.T "user.sessions.kind"}}</th>
<th scope="col">{{.T "sessions.address"}}</th>
<th scope="col">{{.T "sessions.browser"}}</th>
<th scope="col"><span class="sr-only">{{.T "sessions.action"}}</span></th>
</tr>
</thead>
<tbody>
{{range .Data.Sessions}}<tr>
<td>{{$.Time .CreatedAt}}</td>
<td>{{$.Time .LastSeenAt}}</td>
<td>{{$.Time .ExpiresAt}}</td>
<td>{{.Kind}}</td>
<td>{{.IP}}</td>
<td class="break">{{.UserAgent}}</td>
<td><form method="post" action="{{$.Base}}/users/{{$.Data.ID}}/sessions/end">
<input type="hidden" name="csrf" value="{{$.CSRF}}">
<input type="hidden" name="session" value="{{.ID}}">
<button type="submit" class="btn btn-secondary btn-small">{{$.T "sessions.end"}}</button>
</form></td>
</tr>
{{end}}</tbody>
</table>
</div>
<form method="post" action="{{.Base}}/users/{{.Data.ID}}/sessions/end-all">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<button type="submit" class="btn btn-danger">{{.T "user.sessions.end.all"}}</button>
</form>{{else}}<p class="muted">{{.T "user.sessions.none"}}</p>{{end}}
</div>
<div class="card stack">
<h2 class="h2">{{.T "user.signins"}}</h2>
{{template "auditrows" (.AuditTable "user.signins.caption" "user.signins.none" false .Data.SignIns)}}
</div>
<div class="card stack">
<h2 class="h2">{{.T "user.journal"}}</h2>
{{template "auditrows" (.AuditTable "user.journal.caption" "user.journal.none" false .Data.Journal)}}
<p><a href="{{.Data.AuditHref}}">{{.T "user.audit"}}</a></p>
</div>
{{if eq .Data.Status "deleted"}}<div class="card stack">
<h2 class="h2">{{.T "user.restore.title"}}</h2>
<p class="muted">{{.T "user.restore.hint"}}</p>
<form method="post" action="{{.Base}}/users/{{.Data.ID}}/restore" class="stack">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<div class="actions"><button type="submit" class="btn btn-primary">{{.T "user.restore.submit"}}</button></div>
</form>
</div>{{else}}<div class="card stack">
<h2 class="h2">{{.T "user.delete.title"}}</h2>
<p class="muted">{{if .Data.Immediate}}{{.T "user.delete.hint.immediate"}}{{else}}{{.T "user.delete.hint.soft"}}{{end}}</p>
<form method="post" action="{{.Base}}/users/{{.Data.ID}}/delete" class="stack">
<input type="hidden" name="csrf" value="{{.CSRF}}">
<div>
<label for="delete-confirm" class="label">{{.T "user.delete.confirm"}}</label>
<input id="delete-confirm" name="confirm" type="text" class="input" required autocomplete="off" maxlength="256" aria-describedby="delete-confirm-hint">
<p id="delete-confirm-hint" class="muted">{{.T "user.delete.confirm.hint" .Data.Title}}</p>
</div>
<div class="actions"><button type="submit" class="btn btn-danger">{{.T "user.delete.submit"}}</button></div>
</form>
</div>{{end}}
</section>
{{end}}
